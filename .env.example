# Server Environment Variables
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=word_of_covenant_db
DB_PORT=3306

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# File Upload
MAX_FILE_SIZE=50MB
UPLOAD_PATH=./uploads

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email Configuration 
# Using Brevo SMTP as primary provider
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=ab4311001@smtp-brevo.com
EMAIL_PASSWORD=your_brevo_smtp_password_here
# Brevo API key for REST fallback when SMTP is unavailable
BREVO_API_KEY=your_brevo_api_key_here
# Optional Resend API key if you also use Resend as a fallback provider
# RESEND_API_KEY=re_xxx
RESEND_FROM=admin@hocfam.org

# SMTP Timeout Configuration
# Increase these if you're experiencing timeout issues with your email provider
SMTP_TIMEOUT_MS=20000
SMTP_BLOCKING_WAIT_MS=15000
SMTP_FAILURE_COOLDOWN_MS=60000
SMTP_SINGLE_ACCOUNT=true
SMTP_DEBUG=false
# RESEND_API_KEY=your_resend_api_key_here
# EMAIL_MODE=resend

# Email timeouts
SMTP_TIMEOUT_MS=12000
SMTP_BLOCKING_WAIT_MS=5000
SMTP_FAILURE_COOLDOWN_MS=60000
SMTP_SINGLE_ACCOUNT=true
SMTP_DEBUG=false

# Optional API fallback for mail delivery when SMTP is unreachable
# RESEND_API_KEY=re_xxx
# RESEND_FROM=admin@hocfam.org

# Organization mailbox routing
# These are used internally for categorizing emails
ORG_EMAIL_ADMIN=admin@hocfam.org
ORG_EMAIL_INFO=info@hocfam.org
ORG_EMAIL_SUPPORT=support@hocfam.org
ORG_EMAIL_MEDIA=media@hocfam.org
PRAYER_REQUEST_EMAIL=admin@hocfam.org

# Cloudflare Email Routing Configuration
# Set up these routes in Cloudflare dashboard:
# admin@hocfam.org → hocfamadmin@gmail.com
# info@hocfam.org → hocfaminfo@gmail.com
# support@hocfam.org → hocfamsupport@gmail.com
# media@hocfam.org → hocfammedia@gmail.com

# Note: SMTP sending uses single Brevo account (EMAIL_USER/EMAIL_PASSWORD above)
# The per-mailbox credentials below are NOT currently used with Brevo setup
# EMAIL_ADMIN_USER=admin@hocfam.org
# EMAIL_ADMIN_PASSWORD=
# EMAIL_INFO_USER=info@hocfam.org
# EMAIL_INFO_PASSWORD=
# EMAIL_SUPPORT_USER=support@hocfam.org
# EMAIL_SUPPORT_PASSWORD=
# EMAIL_MEDIA_USER=media@hocfam.org
# EMAIL_MEDIA_PASSWORD=

# SMS Configuration (Africa's Talking)
# Get your API key from https://africastalking.com/
SMS_API_KEY=your-africastalking-api-key
SMS_USERNAME=sandbox
SMS_SENDER=WORDCOV

# Alternative: Twilio SMS Configuration
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# ========== CALENDAR SYSTEM ==========
# Yearly calendar for events, activities, and birthdays
# Automatic reminders sent via email and WhatsApp

# WhatsApp Business API Configuration
# Get these from your WhatsApp Business Account
WHATSAPP_API_URL=https://graph.instagram.com/v18.0
WHATSAPP_PHONE_ID=your-whatsapp-phone-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_FROM_PHONE=+1234567890
WHATSAPP_WEBHOOK_TOKEN=test_token

# Calendar Reminder Settings
# Daily reminders sent for events starting 3 months before event date
# Birthday greetings sent at 6:00 AM on birthday
CALENDAR_REMINDER_ENABLED=true
CALENDAR_BIRTHDAY_ENABLED=true

# Reminder timing
# Event reminders: sent daily starting 3 months before event
# Birthday reminders: sent once at 6:00 AM on birthday date
# Default times (change in timezone if needed):
# - Event reminders: 9:00 AM daily
# - Birthday greetings: 6:00 AM
